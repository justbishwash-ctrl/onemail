{
  "name": "onemail",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/worker"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/worker\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/worker",
    "deploy": "bash scripts/deploy.sh",
    "db:migrate": "wrangler d1 migrations apply onemail-db",
    "db:migrate:local": "wrangler d1 migrations apply onemail-db --local",
    "test": "npm run test -w apps/worker"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.3"
  }
}
